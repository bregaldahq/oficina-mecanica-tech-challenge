{
    "name": "oficina/lambda-auth",
    "description": "Lambdas de autenticacao por CPF e authorizer JWT do API Gateway da Oficina Mecanica.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "bref/bref": "^2.0",
        "aws/aws-sdk-php": "^3.300"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "Oficina\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oficina\\Auth\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    }
}
