      "name": "1. Autenticação do cliente (POST /auth/cpf)",
      "description": "Rota pública no API Gateway, atendida pela Lambda `auth-cpf`. Não passa pelo authorizer. Códigos de erro conforme a seção 5 dos Contratos.",
      "item": [
        {
          "name": "Sucesso — CPF de cliente ACTIVE (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('devolve token, expiresIn e customer', function () {",
                  "    pm.expect(body).to.have.property('token');",
                  "    pm.expect(body).to.have.property('expiresIn');",
                  "    pm.expect(body.customer).to.have.property('id');",
                  "});",
                  "",
                  "// Guarda o token de cliente para as próximas requisições da coleção.",
                  "pm.collectionVariables.set('tokenCliente', body.token);",
                  "pm.collectionVariables.set('customerId', body.customer.id);",
                  "console.log('tokenCliente salvo para', body.customer.name);"
