    {
      "name": "0. Saúde",
      "description": "Endpoints públicos de sonda usados pelo Kubernetes: /api/health é a liveness (não toca no banco) e /api/ready é a readiness (checa o banco).",
      "item": [
        {
          "name": "GET /api/health (liveness, público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('não exige token', function () {",
                  "    pm.expect(pm.request.headers.has('Authorization')).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Liveness. Público e sem token. Não toca no banco — por isso uma queda do RDS não provoca restart loop."
          },
          "response": []
        },
        {
          "name": "GET /api/ready (readiness, público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('reporta o banco', function () {",
                  "    pm.expect(pm.response.text()).to.match(/database|db|ready/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ready"
              ]
            },
            "description": "Readiness. Público. Checa a conectividade com o banco — é o alvo do smoke test do deploy.yml."
          },
          "response": []
        }
      ]
