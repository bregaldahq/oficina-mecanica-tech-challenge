    {
      "name": "4. Escopo do cliente (tokenCliente)",
      "description": "O cliente só enxerga as próprias ordens. Substitui a antiga rota pública GET /api/service-orders/status, removida por vazar dados de qualquer CPF.",
      "item": [
        {
          "name": "GET /api/service-orders/me (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const lista = Array.isArray(body) ? body : (body.data || []);",
                  "",
                  "pm.test('todas as OS pertencem ao cliente do token', function () {",
                  "    const meu = pm.collectionVariables.get('customerId');",
                  "    lista.forEach(function (os) {",
                  "        if (os.customer_id) { pm.expect(os.customer_id).to.eql(meu); }",
                  "    });",
                  "});",
                  "",
                  "if (lista.length > 0) {",
                  "    pm.collectionVariables.set('serviceOrderIdCliente', lista[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/service-orders/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "service-orders",
                "me"
              ]
            },
            "description": "Devolve apenas as OS do `sub` do token."
          },
          "response": []
        },
