APP_ENV=production
APP_DEBUG=false

DB_HOST=db
DB_PORT=3306
DB_DATABASE=oficina_mecanica
DB_USERNAME=oficina_user
DB_PASSWORD=secret123

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Shared token required by the external budget-approval webhook
# (POST /api/service-orders/{id}/approval via the X-Webhook-Token header).
# Leave empty to keep the endpoint open in local development.
WEBHOOK_TOKEN=

# Email (SMTP) notifications on service-order status changes.
# Leave SMTP_HOST/MAIL_TO empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@oficina.local
MAIL_TO=
